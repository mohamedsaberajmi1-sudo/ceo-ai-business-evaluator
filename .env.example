# Optional LLM configuration.
# The application works fully offline with LLM_PROVIDER=none.
# Copy this file to .env and fill only the provider you actually use.
# Never commit the real .env file.

LLM_PROVIDER=none

LLM_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional SQLite storage override (local user history, do not commit)
# EVALUATIONS_DB=data/evaluations.db
